# /usr/lib/systemd/wg-forge@.service
[Unit]
Description=WgForge daemon for Wireguard interface %I
Documentation=https://github.com/fluffymax2005/WgForge
Wants=network-online.target nss-lookup.target
After=network-online.target nss-lookup.target
BindsTo=sys-subsystem-net-devices-%i.device

[Service]
Type=notify
User=root
Group=wgforge

ExecStart=/usr/bin/wgforge-server %I
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

StandardOutput=journal
StandardError=kmsg
SyslogIdentifier=wgforge-%I

ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
StateDirectory=wgforge

[Install]
WantedBy=multi-user.target



